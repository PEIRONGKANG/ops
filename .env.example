# Copy this file to .env before starting the new Java backend.
# These values initialize a new PostgreSQL database only; they do not import legacy data.
POSTGRES_DB=beverage_ops
POSTGRES_USER=beverage_ops
POSTGRES_PASSWORD=replace-with-a-local-development-password

# Required only by the new Spring identity-access service. Generate unique values
# of at least 32 characters; do not reuse the placeholder values below.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_HMAC_SECRET=replace-with-a-different-32-character-random-secret
AUTH_BOOTSTRAP_P1_LOGIN_ID=ADMIN001
AUTH_BOOTSTRAP_P1_TEMP_PASSWORD=replace-with-a-12-to-128-character-temporary-password
AUTH_BOOTSTRAP_P1_CLAIM_SECRET=replace-with-a-one-time-bootstrap-claim-secret
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Local Docker runs over HTTP; set true only behind HTTPS in production.
AUTH_SECURE_COOKIES=false

# Required on the production server. PostgreSQL stores only generated relative paths.
BEVERAGE_OPS_MEDIA_ROOT=/data/beverage-ops/media
BEVERAGE_OPS_MEDIA_PURGE_CRON=0 0 2 * * *
BEVERAGE_OPS_MEDIA_PRODUCTION=true
# Required for Docker Compose: a host directory mounted into the backend container.
BEVERAGE_OPS_MEDIA_HOST_PATH=/data/beverage-ops/media
